<Window x:Class="MWImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MWImageViewer"
        xmlns:h="clr-namespace:Maywork.WPF.Helpers"
        mc:Ignorable="d"
        Title="MWImageViewer" Height="450" Width="800"
        h:FullScreenHelper.Enable="True"
        h:SaveImageShortcut.Target="{Binding ElementName=Image1}">
    <Grid
        x:Name="DropBase"
        h:FileDropHelper.Enable="True">
        <ScrollViewer
            h:ImageScaleHelper.Enable="True"
            h:ImageScaleHelper.AutoResetOnSourceChanged="False">
            <Canvas>
                <Image x:Name="Image1"/>
            </Canvas>
        </ScrollViewer>
    </Grid>
</Window>
